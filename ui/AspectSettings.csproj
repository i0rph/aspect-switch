<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PlatformTarget>x64</PlatformTarget>
    <UseWinUI>true</UseWinUI>
    <UseXamlCompilerExecutable>true</UseXamlCompilerExecutable>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <ApplicationIcon>../assets/app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>AspectSwitch.Settings</AssemblyName>
    <RootNamespace>AspectSettings</RootNamespace>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <PublishTrimmed>false</PublishTrimmed>
    <PublishReadyToRun>false</PublishReadyToRun>
  </PropertyGroup>
  <ItemGroup>
    <Content Include="../assets/app.ico" Link="Assets/app.ico" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../assets/app.png" Link="Assets/app.png" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.260921001" />
    <Compile Include="../src/Settings.cs" Link="Models/Settings.cs" />
    <Compile Include="../src/Compatibility.cs" Link="Models/Compatibility.cs" />
    <Compile Include="../src/Policy.cs" Link="Models/Policy.cs" />
  </ItemGroup>
  <!-- Unpackaged WinUI's generated PRI/XBF files must accompany dotnet publish. -->
  <Target Name="PublishXamlResources" AfterTargets="Publish">
    <ItemGroup>
      <XamlPublishResources Include="$(TargetDir)$(AssemblyName).pri;$(TargetDir)**/*.xbf" />
    </ItemGroup>
    <Copy SourceFiles="@(XamlPublishResources)" DestinationFiles="@(XamlPublishResources->'$(PublishDir)%(RecursiveDir)%(Filename)%(Extension)')" />
  </Target>
</Project>
